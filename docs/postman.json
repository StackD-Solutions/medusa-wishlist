{
	"info": {
		"name": "Medusa Wishlist",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:9000"
		},
		{
			"key": "publishable_api_key",
			"value": ""
		},
		{
			"key": "token",
			"value": ""
		}
	],
	"item": [
		{
			"name": "Store",
			"item": [
				{
					"name": "List wishlists",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/store/wishlists?limit=10&offset=0",
							"host": ["{{base_url}}"],
							"path": ["store", "wishlists"],
							"query": [
								{
									"key": "limit",
									"value": "10"
								},
								{
									"key": "offset",
									"value": "0"
								},
								{
									"key": "name",
									"value": "",
									"disabled": true
								},
								{
									"key": "sales_channel_id",
									"value": "",
									"disabled": true
								},
								{
									"key": "visibility",
									"value": "private",
									"disabled": true
								},
								{
									"key": "product_variant_id",
									"value": "",
									"disabled": true
								}
							]
						},
						"header": [
							{
								"key": "x-publishable-api-key",
								"value": "{{publishable_api_key}}"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						]
					}
				},
				{
					"name": "Create wishlist",
					"request": {
						"method": "POST",
						"url": {
							"raw": "{{base_url}}/store/wishlists",
							"host": ["{{base_url}}"],
							"path": ["store", "wishlists"]
						},
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "x-publishable-api-key",
								"value": "{{publishable_api_key}}"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"My Wishlist\",\n  \"sales_channel_id\": \"<sales_channel_id>\"\n}"
						}
					}
				},
				{
					"name": "Retrieve wishlist",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/store/wishlists/:id",
							"host": ["{{base_url}}"],
							"path": ["store", "wishlists", ":id"],
							"variable": [
								{
									"key": "id",
									"value": "<wishlist_id>"
								}
							]
						},
						"header": [
							{
								"key": "x-publishable-api-key",
								"value": "{{publishable_api_key}}"
							}
						]
					}
				},
				{
					"name": "Update wishlist",
					"request": {
						"method": "PUT",
						"url": {
							"raw": "{{base_url}}/store/wishlists/:id",
							"host": ["{{base_url}}"],
							"path": ["store", "wishlists", ":id"],
							"variable": [
								{
									"key": "id",
									"value": "<wishlist_id>"
								}
							]
						},
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "x-publishable-api-key",
								"value": "{{publishable_api_key}}"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Updated Name\"\n}"
						}
					}
				},
				{
					"name": "Delete wishlist",
					"request": {
						"method": "DELETE",
						"url": {
							"raw": "{{base_url}}/store/wishlists/:id",
							"host": ["{{base_url}}"],
							"path": ["store", "wishlists", ":id"],
							"variable": [
								{
									"key": "id",
									"value": "<wishlist_id>"
								}
							]
						},
						"header": [
							{
								"key": "x-publishable-api-key",
								"value": "{{publishable_api_key}}"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						]
					},
					"response": [
						{
							"name": "Wishlist deleted",
							"status": "OK",
							"code": 200,
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": "{\n  \"id\": \"<wishlist_id>\"\n}"
						}
					]
				},
				{
					"name": "List wishlist items",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/store/wishlists/:id/items?limit=10&offset=0",
							"host": ["{{base_url}}"],
							"path": ["store", "wishlists", ":id", "items"],
							"query": [
								{
									"key": "limit",
									"value": "10"
								},
								{
									"key": "offset",
									"value": "0"
								},
								{
									"key": "product_variant_id",
									"value": "",
									"disabled": true
								}
							],
							"variable": [
								{
									"key": "id",
									"value": "<wishlist_id>"
								}
							]
						},
						"header": [
							{
								"key": "x-publishable-api-key",
								"value": "{{publishable_api_key}}"
							}
						]
					}
				},
				{
					"name": "Add item to wishlist",
					"request": {
						"method": "POST",
						"url": {
							"raw": "{{base_url}}/store/wishlists/:id/items",
							"host": ["{{base_url}}"],
							"path": ["store", "wishlists", ":id", "items"],
							"variable": [
								{
									"key": "id",
									"value": "<wishlist_id>"
								}
							]
						},
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "x-publishable-api-key",
								"value": "{{publishable_api_key}}"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"product_variant_id\": \"<product_variant_id>\"\n}"
						}
					}
				},
				{
					"name": "Remove item from wishlist",
					"request": {
						"method": "DELETE",
						"url": {
							"raw": "{{base_url}}/store/wishlists/:id/items/:product_variant_id",
							"host": ["{{base_url}}"],
							"path": ["store", "wishlists", ":id", "items", ":product_variant_id"],
							"variable": [
								{
									"key": "id",
									"value": "<wishlist_id>"
								},
								{
									"key": "product_variant_id",
									"value": "<product_variant_id>"
								}
							]
						},
						"header": [
							{
								"key": "x-publishable-api-key",
								"value": "{{publishable_api_key}}"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						]
					},
					"response": [
						{
							"name": "Item removed from wishlist",
							"status": "OK",
							"code": 200,
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": "{\n  \"id\": \"<wishlist_item_id>\"\n}"
						}
					]
				}
			]
		},
		{
			"name": "Admin",
			"item": [
				{
					"name": "Get product wishlist count",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/admin/products/:product_id/wishlist",
							"host": ["{{base_url}}"],
							"path": ["admin", "products", ":product_id", "wishlist"],
							"variable": [
								{
									"key": "product_id",
									"value": "<product_id>"
								}
							]
						},
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						]
					}
				},
				{
					"name": "Get variant wishlist count",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/admin/products/:product_id/variants/:variant_id/wishlist",
							"host": ["{{base_url}}"],
							"path": ["admin", "products", ":product_id", "variants", ":variant_id", "wishlist"],
							"variable": [
								{
									"key": "product_id",
									"value": "<product_id>"
								},
								{
									"key": "variant_id",
									"value": "<variant_id>"
								}
							]
						},
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						]
					}
				}
			]
		}
	]
}
